generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Retained development-only persistence probe from the foundation milestone.
model FoundationProbe {
  id        String   @id
  value     String
  createdAt DateTime @default(now())
}

enum ImportStatus {
  PENDING
  PROCESSING
  PAUSED
  COMPLETED
  FAILED
}

enum SourceRowStatus {
  PENDING
  PROCESSING
  DONE
  NEEDS_REVIEW
  FAILED
}

enum ProductRevisionStatus {
  DRAFT
  NEEDS_REVIEW
  APPROVED
  REJECTED
}

enum RowCleaningOutcome {
  READY
  NEEDS_REVIEW
  FAILED
}

enum GroupingRunStatus {
  PENDING
  COMPLETED
}

enum GroupingRowOutcome {
  PENDING
  APPLIED
  NEEDS_REVIEW
  FAILED
}

model Store {
  id        String     @id @default(uuid()) @db.Uuid
  name      String
  createdAt DateTime   @default(now()) @db.Timestamptz(3)
  suppliers Supplier[]
  imports   Import[]
  products  Product[]
}

model Supplier {
  id        String    @id @default(uuid()) @db.Uuid
  storeId   String    @db.Uuid
  name      String
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  store     Store     @relation(fields: [storeId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  imports   Import[]
  products  Product[]

  // Compound reference prevents an import from using another store's supplier.
  @@unique([id, storeId])
  @@index([storeId])
}

model Import {
  id               String            @id @default(uuid()) @db.Uuid
  storeId          String            @db.Uuid
  supplierId       String            @db.Uuid
  originalFilename String
  storageKey       String
  fileSha256       String            @db.VarChar(64)
  idempotencyKey   String
  parserVersion    String
  mappingConfig    Json              @default("{}")
  status           ImportStatus      @default(PENDING)
  totalRows        Int?
  errorCode        String?
  errorMessage     String?
  createdAt        DateTime          @default(now()) @db.Timestamptz(3)
  startedAt        DateTime?         @db.Timestamptz(3)
  finishedAt       DateTime?         @db.Timestamptz(3)
  parseRunId       String?           @db.Uuid
  store            Store             @relation(fields: [storeId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  supplier         Supplier          @relation(fields: [supplierId, storeId], references: [id, storeId], onDelete: Restrict, onUpdate: Restrict)
  sourceRows       SourceRow[]
  productRevisions ProductRevision[]
  parseDispatch    ParseDispatch?
  groupingRun      GroupingRun?

  @@unique([id, storeId])
  @@unique([storeId, supplierId, idempotencyKey])
  @@index([storeId, status])
}

// Narrow parsing outbox: created atomically with an accepted Import.
model ParseDispatch {
  importId     String    @id @db.Uuid
  createdAt    DateTime  @default(now()) @db.Timestamptz(3)
  dispatchedAt DateTime? @db.Timestamptz(3)
  import       Import    @relation(fields: [importId], references: [id], onDelete: Cascade, onUpdate: Restrict)
}

model SourceRow {
  id             String              @id @default(uuid()) @db.Uuid
  importId       String              @db.Uuid
  storeId        String              @db.Uuid
  sheetIndex     Int
  sheetName      String
  rowNumber      Int
  // Ordered array of { columnIndex, header, value }; never key by header alone.
  rawCells       Json
  rowFingerprint String?
  status         SourceRowStatus     @default(PENDING)
  issues         Json                @default("[]")
  createdAt      DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime            @default(now()) @updatedAt @db.Timestamptz(3)
  import         Import              @relation(fields: [importId, storeId], references: [id, storeId], onDelete: Restrict, onUpdate: Restrict)
  revisionLinks  RevisionSourceRow[]
  cleaningResults RowCleaningResult[]
  groupingResults GroupingRowResult[]

  // Source fields are also protected by the migration's UPDATE trigger.
  @@unique([id, storeId])
  @@unique([id, importId, storeId])
  @@unique([importId, sheetIndex, rowNumber])
  @@index([importId, status])
}

// Candidate row data only; READY does not imply grouping or publication.
model RowCleaningResult {
  id             String             @id @default(uuid()) @db.Uuid
  sourceRowId    String             @db.Uuid
  storeId        String             @db.Uuid
  cleanerVersion String
  configHash     String             @db.VarChar(64)
  configSnapshot Json
  normalized     Json
  evidence       Json
  issues         Json
  outcome        RowCleaningOutcome
  createdAt      DateTime           @default(now()) @db.Timestamptz(3)
  sourceRow      SourceRow          @relation(fields: [sourceRowId, storeId], references: [id, storeId], onDelete: Restrict, onUpdate: Restrict)
  groupingResults GroupingRowResult[]
  revisionLinks   RevisionSourceRow[]

  @@unique([id, sourceRowId, storeId])
  @@unique([sourceRowId, cleanerVersion, configHash])
}

model Product {
  id                  String            @id @default(uuid()) @db.Uuid
  storeId             String            @db.Uuid
  supplierId          String            @db.Uuid
  supplierProductKey  String?
  publishedRevisionId String?           @db.Uuid
  createdAt           DateTime          @default(now()) @db.Timestamptz(3)
  archivedAt          DateTime?         @db.Timestamptz(3)
  store               Store             @relation(fields: [storeId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  supplier            Supplier          @relation(fields: [supplierId, storeId], references: [id, storeId], onDelete: Restrict, onUpdate: Restrict)
  variants            Variant[]
  revisions           ProductRevision[] @relation("ProductRevisions")
  publishedRevision   ProductRevision?  @relation("PublishedRevision", fields: [publishedRevisionId, id, storeId], references: [id, productId, storeId], onDelete: Restrict, onUpdate: Restrict)

  @@unique([id, storeId])
  // Archived identities retain their identifiers; no active-only uniqueness.
  @@unique([storeId, supplierId, supplierProductKey])
}

model Variant {
  id         String            @id @default(uuid()) @db.Uuid
  productId  String            @db.Uuid
  storeId    String            @db.Uuid
  // PostgreSQL canonicalizes inserts/updates; use findVariantBySku for raw lookups.
  sku        String
  createdAt  DateTime          @default(now()) @db.Timestamptz(3)
  archivedAt DateTime?         @db.Timestamptz(3)
  product    Product           @relation(fields: [productId, storeId], references: [id, storeId], onDelete: Restrict, onUpdate: Restrict)
  revisions  VariantRevision[]

  @@unique([id, productId, storeId])
  @@unique([storeId, sku])
  @@index([productId])
}

model ProductRevision {
  id                      String                @id @default(uuid()) @db.Uuid
  productId               String                @db.Uuid
  storeId                 String                @db.Uuid
  originImportId          String?               @db.Uuid
  groupingRunId           String?               @db.Uuid
  basePublishedRevisionId String?               @db.Uuid
  status                  ProductRevisionStatus @default(DRAFT)
  title                   String?
  descriptionHtml         String?
  categoryKey             String?
  tags                    String[]              @default([])
  attributes              Json                  @default("{}")
  reviewReasons           Json                  @default("[]")
  manualFieldPaths        String[]              @default([])
  editVersion             Int                   @default(1)
  createdAt               DateTime              @default(now()) @db.Timestamptz(3)
  approvedAt              DateTime?             @db.Timestamptz(3)
  product                 Product               @relation("ProductRevisions", fields: [productId, storeId], references: [id, storeId], onDelete: Restrict, onUpdate: Restrict)
  originImport            Import?               @relation(fields: [originImportId, storeId], references: [id, storeId], onDelete: Restrict, onUpdate: Restrict)
  basePublishedRevision   ProductRevision?      @relation("RevisionBaseline", fields: [basePublishedRevisionId, productId, storeId], references: [id, productId, storeId], onDelete: Restrict, onUpdate: Restrict)
  basedOnBy               ProductRevision[]     @relation("RevisionBaseline")
  publishedFor            Product[]             @relation("PublishedRevision")
  variants                VariantRevision[]
  sourceRows              RevisionSourceRow[]
  groupingRun             GroupingRun?          @relation(fields: [groupingRunId, originImportId, storeId], references: [id, importId, storeId], onDelete: Restrict, onUpdate: Restrict)
  groupingResults         GroupingRowResult[]

  @@unique([id, groupingRunId, storeId])
  @@unique([id, productId, storeId])
  @@unique([id, storeId])
  @@unique([originImportId, productId])
  @@index([productId, createdAt])
}

model VariantRevision {
  productRevisionId String              @db.Uuid
  variantId         String              @db.Uuid
  storeId           String              @db.Uuid
  productId         String              @db.Uuid
  options           Json                @default("{}")
  priceMinor        BigInt?             @db.BigInt
  currency          String?             @db.VarChar(3)
  weightGrams       Int?
  manualFieldPaths  String[]            @default([])
  productRevision   ProductRevision     @relation(fields: [productRevisionId, productId, storeId], references: [id, productId, storeId], onDelete: Restrict, onUpdate: Restrict)
  variant           Variant             @relation(fields: [variantId, productId, storeId], references: [id, productId, storeId], onDelete: Restrict, onUpdate: Restrict)
  sourceRows        RevisionSourceRow[]
  groupingResults  GroupingRowResult[]

  @@id([productRevisionId, variantId])
  @@index([variantId])
}

model RevisionSourceRow {
  sourceRowId       String           @db.Uuid
  productRevisionId String           @db.Uuid
  variantId         String?          @db.Uuid
  storeId           String           @db.Uuid
  cleaningResultId  String?          @db.Uuid
  sourceRow         SourceRow        @relation(fields: [sourceRowId, storeId], references: [id, storeId], onDelete: Restrict, onUpdate: Restrict)
  productRevision   ProductRevision  @relation(fields: [productRevisionId, storeId], references: [id, storeId], onDelete: Restrict, onUpdate: Restrict)
  variantRevision   VariantRevision? @relation(fields: [productRevisionId, variantId], references: [productRevisionId, variantId], onDelete: Restrict, onUpdate: Restrict)
  cleaningResult    RowCleaningResult? @relation(fields: [cleaningResultId, sourceRowId, storeId], references: [id, sourceRowId, storeId], onDelete: Restrict, onUpdate: Restrict)

  @@id([sourceRowId, productRevisionId])
  @@index([productRevisionId, variantId])
}

// One frozen, explicitly selected cleaning interpretation per accepted import.
model GroupingRun {
  id             String @id @default(uuid()) @db.Uuid
  importId       String @unique @db.Uuid
  storeId        String @db.Uuid
  grouperVersion String
  configHash     String @db.VarChar(64)
  configSnapshot Json
  inputHash      String @db.VarChar(64)
  plan           Json
  status         GroupingRunStatus @default(PENDING)
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  finishedAt     DateTime? @db.Timestamptz(3)
  import         Import @relation(fields: [importId, storeId], references: [id, storeId], onDelete: Restrict, onUpdate: Restrict)
  rows           GroupingRowResult[]
  revisions      ProductRevision[]

  @@unique([importId, storeId])
  @@unique([id, importId, storeId])
}

model GroupingRowResult {
  runId             String @db.Uuid
  importId          String @db.Uuid
  storeId           String @db.Uuid
  sourceRowId       String @db.Uuid
  cleaningResultId  String @db.Uuid
  groupKey          String
  outcome           GroupingRowOutcome @default(PENDING)
  issues            Json @default("[]")
  productRevisionId String? @db.Uuid
  variantId         String? @db.Uuid
  run               GroupingRun @relation(fields: [runId, importId, storeId], references: [id, importId, storeId], onDelete: Restrict, onUpdate: Restrict)
  sourceRow         SourceRow @relation(fields: [sourceRowId, importId, storeId], references: [id, importId, storeId], onDelete: Restrict, onUpdate: Restrict)
  cleaningResult    RowCleaningResult @relation(fields: [cleaningResultId, sourceRowId, storeId], references: [id, sourceRowId, storeId], onDelete: Restrict, onUpdate: Restrict)
  revision          ProductRevision? @relation(fields: [productRevisionId, runId, storeId], references: [id, groupingRunId, storeId], onDelete: Restrict, onUpdate: Restrict)
  variantRevision   VariantRevision? @relation(fields: [productRevisionId, variantId], references: [productRevisionId, variantId], onDelete: Restrict, onUpdate: Restrict)

  @@id([runId, sourceRowId])
  @@index([runId, groupKey])
}

# Copy to .env at the repository root. Fill in your own LOCAL password.
# Never reuse production credentials. The connection URL password must be URL-encoded.
POSTGRES_USER=catalogforge
POSTGRES_PASSWORD=
POSTGRES_DB=catalogforge
POSTGRES_PORT=5432
DATABASE_URL=postgresql://catalogforge:REPLACE_WITH_URL_ENCODED_PASSWORD@127.0.0.1:5432/catalogforge

# Host applications use 127.0.0.1, not Docker service names.
REDIS_PORT=6379
REDIS_URL=redis://127.0.0.1:6379
WEB_APP_URL=http://localhost:3000
WORKER_HEALTH_PORT=3001

# Explicit opt-in for unauthenticated localhost-only ingestion (never production).
DEV_INGESTION_ENABLED=false
DEV_STORE_ID=00000000-0000-4000-8000-000000000001
DEV_SUPPLIER_ID=00000000-0000-4000-8000-000000000002
# Set an absolute private path, e.g. your repository's .local/uploads directory.
LOCAL_UPLOAD_DIR=

# Required for real one-product enrichment. No stub or paid-provider fallback.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
# Set true ONLY after verifying billing is disabled for this key's Google project.
# A zero price in application code cannot turn a billed project into a free one.
GEMINI_BILLING_DISABLED=false
# Conservative app-wide limits; actual Google project quotas may be lower.
GEMINI_REQUESTS_PER_DAY=5
GEMINI_INPUT_TOKENS_PER_MINUTE=10000

# Reserved; leave blank. Not consumed yet.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

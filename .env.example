# Copy to .env at the repository root. Fill in your own LOCAL password.
# Never reuse production credentials. The connection URL password must be URL-encoded.
POSTGRES_USER=catalogforge
POSTGRES_PASSWORD=
POSTGRES_DB=catalogforge
POSTGRES_PORT=5432
DATABASE_URL=postgresql://catalogforge:REPLACE_WITH_URL_ENCODED_PASSWORD@127.0.0.1:5432/catalogforge

# Host applications use 127.0.0.1, not Docker service names.
REDIS_PORT=6379
REDIS_URL=redis://127.0.0.1:6379
WEB_APP_URL=http://localhost:3000
WORKER_HEALTH_PORT=3001

# Reserved for later milestones; leave blank. Not required or consumed yet.
OPENAI_API_KEY=
GEMINI_API_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

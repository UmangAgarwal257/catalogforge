# Environment template. Replace placeholders in the deployment secret manager.
# Never commit the populated environment file or use paid AI fallback.
WEB_APP_URL=https://catalogforge.example
DATABASE_URL=postgresql://USER:URL_ENCODED_PASSWORD@DB_HOST:5432/postgres
STOREFRONT_STORE_ID=00000000-0000-4000-8000-000000000001

# Supabase Auth and private Storage.
NEXT_PUBLIC_SUPABASE_URL=https://PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=catalogforge-private

# Separate worker service.
REDIS_URL=rediss://DEFAULT_USER:URL_ENCODED_PASSWORD@REDIS_HOST:6379
WORKER_STORE_ID=00000000-0000-4000-8000-000000000001
WORKER_HEALTH_PORT=3001

# Gemini Developer API; set billing-disabled confirmation only after verifying
# billing is disabled for the Google project that owns this key.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
GEMINI_BILLING_DISABLED=false
GEMINI_REQUESTS_PER_DAY=5
GEMINI_INPUT_TOKENS_PER_MINUTE=10000

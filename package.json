{
  "name": "catalogforge",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.12",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --cwd apps/web dev",
    "dev:worker": "bun --env-file=.env run apps/worker/src/index.ts",
    "build": "bun run db:generate && bun run --cwd apps/web build",
    "infra:up": "docker compose up -d --wait",
    "infra:down": "docker compose down",
    "infra:status": "docker compose ps",
    "db:generate": "bun run --cwd packages/db generate",
    "db:migrate": "bun run --cwd packages/db migrate",
    "db:deploy": "bun run --cwd packages/db deploy",
    "db:check": "bun --env-file=.env run packages/db/src/check.ts",
    "worker:smoke": "bun --env-file=.env run apps/worker/src/smoke.ts",
    "typecheck": "tsc -p packages/shared --noEmit && tsc -p packages/db --noEmit && tsc -p packages/ingestion --noEmit && tsc -p packages/cleaning --noEmit && tsc -p packages/grouping --noEmit && tsc -p packages/enrichment --noEmit && tsc -p apps/worker --noEmit && tsc -p apps/web --noEmit && tsc -p tsconfig.tools.json --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run --exclude '**/*.integration.test.ts'",
    "test:integration": "bun --env-file=.env run test:integration:run",
    "test:integration:run": "vitest run .integration.test.ts",
    "db:seed:dev": "bun --env-file=.env run packages/db/src/seed-dev.ts",
    "enrich:one": "bun --env-file=.env run apps/worker/src/enrich-one.ts"
  },
  "devDependencies": {
    "@catalogforge/db": "workspace:*",
    "@catalogforge/grouping": "workspace:*",
    "@catalogforge/ingestion": "workspace:*",
    "@catalogforge/cleaning": "workspace:*",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/bun": "1.3.12",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "bullmq": "6.4.0",
    "eslint": "^9.39.0",
    "eslint-config-next": "16.4.2",
    "exceljs": "^4.4.0",
    "ioredis": "^5.8.0",
    "jsdom": "^30.1.3",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "5.0.5",
    "@catalogforge/enrichment": "workspace:*"
  }
}
